{
  "sourceLanguage" : "ja",
  "strings" : {
    "%@ %lld / %lld" : {
      "comment" : "A text showing the current number of unlocked fish out of the total number of fish. The argument is the string “encyclopedia.progress”.",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "%1$@ %2$lld / %3$lld"
          }
        }
      }
    },
    "%@: %lld" : {
      "comment" : "A text displaying the price of a specific bait. The argument is the price of the bait. The argument is the string “shop.price”.",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "%1$@: %2$lld"
          }
        }
      }
    },
    "%lld" : {
      "comment" : "A text view displaying the number of coins earned in a fishing result. The text is styled to be bold and the primary text color.",
      "isCommentAutoGenerated" : true
    },
    "%lld / %lld" : {
      "comment" : "A text displaying the number of unlocked fish out of the total number of fish. The first argument is the count of unlocked fish. The second argument is the total count of fish.",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "%1$lld / %2$lld"
          }
        }
      }
    },
